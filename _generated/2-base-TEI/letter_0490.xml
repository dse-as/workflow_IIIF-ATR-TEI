   <text>
      <body>
         <div type="letter">
            <pb xml:id="p001" facs="https://iiif.ub.unibe.ch/image/v3/schwarzenbach/letter_0490_001.jpg"/>
            <milestone unit="textregion" xml:id="p001_r_2"/>
            <p xmlns:local="local" local:warning="FML-generated-to-avoid-structural-problems">
               <lb xml:id="p001_l_1"/>Nov. 17 
               <lb xml:id="p001_l_2"/>Liebe Bodmerlis</p>
            <p>
               <lb xml:id="p001_l_3"/>hier wird Baumwolle 
               <lb xml:id="p001_l_4"/>Zuckerrohr u. Terpentin 
               <lb xml:id="p001_l_5"/>verfrachtet, der Fluss 
               <lb xml:id="p001_l_6"/>ist gelb u. langsam, 
               <lb xml:id="p001_l_7"/>u. die Neger singen 
               <lb xml:id="p001_l_8"/>am Abend in ihren 
               <lb xml:id="p001_l_9"/>Hütten. Jch möchte mehr 
               <lb xml:id="p001_l_10"/>schreiben, habe aber nie 
               <lb xml:id="p001_l_11"/>Zeit – u. wünsche mir 
               <lb xml:id="p001_l_14"/>dass ihr gesund u. 
               <lb xml:id="p001_l_12"/>lustig seid? Eure Annemarie</p>
            <milestone unit="textregion" xml:id="p001_r"/>
            <p xmlns:local="local" local:warning="FML-generated-to-avoid-structural-problems">
               <lb xml:id="p001_l"/>P. S.</p>
            <p>
               <lb xml:id="p001_l_13"/>Erika ist in New York 
               <lb xml:id="p001_l_15"/>ich ab Dez. "zurück" – dort</p>
            <milestone unit="textregion" xml:id="p001_r_1"/>
            <p xmlns:local="local" local:warning="FML-generated-to-avoid-structural-problems">
               <lb xml:id="p001_l_16"/>Mrs. Robert Bodmer 
               <lb xml:id="p001_l_17"/>Hergiswil 
               <lb xml:id="p001_l_18"/>am See 
               <lb xml:id="p001_l_19"/>Nidwalden 
               <lb xml:id="p001_l_20"/><hi rendition="#u">SWITZERLAND</hi></p>
            <milestone unit="textregion" xml:id="p001_r_3"/>
            <p xmlns:local="local" local:warning="FML-generated-to-avoid-structural-problems">
               <lb xml:id="p001_l_21"/>2 Savannah 
               <lb xml:id="p001_l_22"/>GA. 
               <lb xml:id="p001_l_23"/>NOV 17 
               <lb xml:id="p001_l_24"/>1<hi rendition="#sup">30</hi> PM 
               <lb xml:id="p001_l_25"/>1937</p>
            <pb xml:id="p002" facs="https://iiif.ub.unibe.ch/image/v3/schwarzenbach/letter_0490_002.jpg"/></div>

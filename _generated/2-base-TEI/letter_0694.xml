   <text>
      <body>
         <div type="letter">
            <pb xml:id="p001" facs="https://iiif.ub.unibe.ch/image/v3/schwarzenbach/letter_0694_001.jpg"/>
            <milestone unit="textregion" xml:id="p001_r"/>
            <p xmlns:local="local" local:warning="FML-generated-to-avoid-structural-problems">
               <lb xml:id="p001_l"/>1</p>
            <milestone unit="textregion" xml:id="p001_tr_2"/>
            <p xmlns:local="local" local:warning="FML-generated-to-avoid-structural-problems">
               <lb xml:id="p001_tr_2_tl_1"/>21. Juni 29 
               <lb xml:id="p001_tr_2_tl_2"/>Paris 
               <lb xml:id="p001_tr_2_tl_3"/>Lieber Herr von Haushofer, 
               <lb xml:id="p001_tr_2_tl_4"/>Sie sind wahrscheinlich 
               <lb xml:id="p001_tr_2_tl_5"/>ein wenig böse oder enttäuscht 
               <lb xml:id="p001_tr_2_tl_6"/>dass ich Ihnen nicht 
               <lb xml:id="p001_tr_2_tl_7"/>früher geantwortet habe, 
               <lb xml:id="p001_tr_2_tl_8"/>aber Sie haben mich 
               <lb xml:id="p001_tr_2_tl_9"/>mit Ihrer Frage über 
               <lb xml:id="p001_tr_2_tl_10" break="no"/>schätzt: ich kan[ Ihren 
               <lb xml:id="p001_tr_2_tl_11"/>Aufsatz gar nicht kritisieren 
               <lb xml:id="p001_tr_2_tl_12"/>ich habe ihn mit grösstem 
               <lb xml:id="p001_tr_2_tl_13"/>Interesse gelesen, u. wahr 
               <lb xml:id="p001_tr_2_tl_14" break="no"/>scheinlich auch verstanden, 
               <lb xml:id="p001_tr_2_tl_15"/>aber gerade genug um 
               <lb xml:id="p001_tr_2_tl_16"/>zu sehen dass ich nicht 
               <lb xml:id="p001_tr_2_tl_17"/>genug von diesen Fragen 
               <lb xml:id="p001_tr_2_tl_18"/>weiss um ein Urteil</p>
            <pb xml:id="p002" facs="https://iiif.ub.unibe.ch/image/v3/schwarzenbach/letter_0694_002.jpg"/>
            <milestone unit="textregion" xml:id="p002_tr_1"/>
            <p xmlns:local="local" local:warning="FML-generated-to-avoid-structural-problems">
               <lb xml:id="p002_tr_1_tl_1"/>abzugeben. Wichtig u. von 
               <lb xml:id="p002_tr_1_tl_2"/>beinah leidenschaftlichem 
               <lb xml:id="p002_tr_1_tl_3"/>Interesse für mich war 
               <lb xml:id="p002_tr_1_tl_4"/>Ihre knappe, unsenti 
               <lb xml:id="p002_l" break="no"/>mentale u. sachliche 
               <lb xml:id="p002_tr_1_tl_7"/>Darstellung der <PAGE tag="continued">Unmö</PAGE>
               <lb xml:id="p002_tr_1_tl_8" break="no"/><PAGE tag="continued">lichkeit</PAGE> eines neuen 
               <lb xml:id="p002_tr_1_tl_9"/>Krieges – Man spricht 
               <lb xml:id="p002_tr_1_tl_10"/>ja andauernd davon, 
               <lb xml:id="p002_tr_1_tl_11"/>aber noch nie habe ich 
               <lb xml:id="p002_tr_1_tl_12"/>eine so deutliche u. einfache 
               <lb xml:id="p002_tr_1_tl_13"/>Zusammenfassung der Folgen 
               <lb xml:id="p002_tr_1_tl_14"/>gesehen. Wen[ etwas, so 
               <lb xml:id="p002_tr_1_tl_15"/>wird diese Art der Auf 
               <lb xml:id="p002_tr_1_tl_16" break="no"/>klärung das Mittel sein 
               <lb xml:id="p002_tr_1_tl_17"/>neue Katastrophen zu 
               <lb xml:id="p002_tr_1_tl_18"/>vermeiden u. den Leuten 
               <lb xml:id="p002_tr_1_tl_19"/>die Augen zu öffnen. –</p>
            <pb xml:id="p003" facs="https://iiif.ub.unibe.ch/image/v3/schwarzenbach/letter_0694_003.jpg"/>
            <milestone unit="textregion" xml:id="p003_tr_2"/>
            <p xmlns:local="local" local:warning="FML-generated-to-avoid-structural-problems">
               <lb xml:id="p003_tr_2_tl_1"/>2</p>
            <milestone unit="textregion" xml:id="p003_tr_3"/>
            <p xmlns:local="local" local:warning="FML-generated-to-avoid-structural-problems">
               <lb xml:id="p003_tr_3_tl_1"/>Ihre raumpolitischen 
               <lb xml:id="p003_tr_3_tl_2"/>Erläuterungen sind selten 
               <lb xml:id="p003_tr_3_tl_3"/>aufschlussreich. Es ko[mt 
               <lb xml:id="p003_tr_3_tl_4"/>mir jetzt zum Bewusstsein, 
               <lb xml:id="p003_tr_3_tl_5"/>wie zahllos die Probleme – 
               <lb xml:id="p003_tr_3_tl_6"/>u. ihre Lösungsmöglich 
               <lb xml:id="p003_tr_3_tl_7" break="no"/>keiten sind. Manchmal 
               <lb xml:id="p003_tr_3_tl_8"/>denke ich, man müsste 
               <lb xml:id="p003_tr_3_tl_9"/>als Grundlage aller politischen 
               <lb xml:id="p003_tr_3_tl_10"/>(wie historischen!) u. selbst 
               <lb xml:id="p003_tr_3_tl_11"/>rassenkundlichen Studien 
               <lb xml:id="p003_tr_3_tl_12"/>Geographie treiben, in die 
               <lb xml:id="p003_tr_3_tl_13"/>Geheimnisse des Raums, 
               <lb xml:id="p003_tr_3_tl_14"/>des Bodens, der Form 
               <lb xml:id="p003_tr_3_tl_15"/>eindringen u. man würde 
               <lb xml:id="p003_tr_3_tl_16"/>davon ungehoffte Resultate 
               <lb xml:id="p003_tr_3_tl_17"/>erzielen.</p>
            <pb xml:id="p004" facs="https://iiif.ub.unibe.ch/image/v3/schwarzenbach/letter_0694_004.jpg"/>
            <milestone unit="textregion" xml:id="p004_tr_1"/>
            <p xmlns:local="local" local:warning="FML-generated-to-avoid-structural-problems">
               <lb xml:id="p004_tr_1_tl_1"/>Verzeihen Sie bitte dass ich 
               <lb xml:id="p004_tr_1_tl_2"/>für Ihre Gedichte nicht 
               <lb xml:id="p004_tr_1_tl_3"/>dankte, sie machten mir 
               <lb xml:id="p004_tr_1_tl_4"/>grosse Freude. Es war, 
               <lb xml:id="p004_tr_1_tl_5"/>wie Sie vermuteten, nur 
               <lb xml:id="p004_tr_1_tl_6"/>Nachlässigkeit u. der in 
               <lb xml:id="p004_tr_1_tl_7"/>dieser allzu reichen Stadt 
               <lb xml:id="p004_tr_1_tl_8"/>unvermeidliche Zeitmangel. 
               <lb xml:id="p004_tr_1_tl_9"/>Freundlicher Gruss Ihre 
               <lb xml:id="p004_tr_1_tl_10"/>A[nemarie Schwarzenbach</p>
            <pb xml:id="p005" facs="https://iiif.ub.unibe.ch/image/v3/schwarzenbach/letter_0694_005.jpg"/>
            <milestone unit="textregion" xml:id="p005_tr_1"/>
            <p xmlns:local="local" local:warning="FML-generated-to-avoid-structural-problems">
               <lb xml:id="p005_tr_1_tl_1"/>Allemagne 
               <lb xml:id="p005_tr_1_tl_2"/>PARIS 25 
               <lb xml:id="p005_tr_1_tl_3"/>21 · VI 
               <lb xml:id="p005_tr_1_tl_4"/>1929 
               <lb xml:id="p005_tr_1_tl_5"/>R. DANTON 
               <lb xml:id="p005_tr_1_tl_6"/>Herrn Albrecht Haushofer 
               <lb xml:id="p005_tr_1_tl_7"/>Berlin SW 48 
               <lb xml:id="p005_tr_1_tl_8"/>Wilhelmstrasse 23</p>
            <pb xml:id="p006" facs="https://iiif.ub.unibe.ch/image/v3/schwarzenbach/letter_0694_006.jpg"/>
            <milestone unit="textregion" xml:id="p006_tr_1"/>
            <p xmlns:local="local" local:warning="FML-generated-to-avoid-structural-problems">
               <lb xml:id="p006_tr_1_tl_1"/>2 c)</p>
            <milestone unit="textregion" xml:id="p006_tr_2"/>
            <p xmlns:local="local" local:warning="FML-generated-to-avoid-structural-problems">
               <lb xml:id="p006_tr_2_tl_1"/>FOYER INTERNATIONAL DES ETUDIANTES 
               <lb xml:id="p006_tr_2_tl_2"/>STUDENT HOSTEL 
               <lb xml:id="p006_tr_2_tl_3"/>93, BOULEVARD SAINT-MICHEL 
               <lb xml:id="p006_tr_2_tl_4"/>PARIS</p>
         </div>

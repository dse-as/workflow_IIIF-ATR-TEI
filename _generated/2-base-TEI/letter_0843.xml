      <body> 
         <div type="letter">
            <pb xml:id="p001" facs="https://iiif.ub.unibe.ch/image/v3/schwarzenbach/letter_0843_001.jpg"/>
            <milestone unit="textregion" xml:id="p001_r"/>            <p xmlns:local="local" local:warning="FML-generated-to-avoid-structural-problems"> 
               <lb xml:id="p001_l"/>Dominique chérie, je te souhaite 
               <lb xml:id="p001_l_1"/>une bonne et heureuse 
               <lb xml:id="p001_l_2"/>nuvelle année – et je 
               <lb xml:id="p001_l_3"/>t'attends avec impatience – 
               <lb xml:id="p001_l_4"/>N'ayant pas ton adresse 
               <lb xml:id="p001_l_5"/>je ne sais pas quand 
               <lb xml:id="p001_l_6"/>tu auras cette carte – 
               <lb xml:id="p001_l_7"/>Envoie-moi l'adresse de 
               <lb xml:id="p001_l_8"/>Anne!!! Alle guten Wünsche 
               <lb xml:id="p001_l_9"/>von meiner ganzen Familie 
               <lb xml:id="p001_l_10"/>u bitte Deine Eltern u. 
               <lb xml:id="p001_l_11"/>Sylvie – 
               <lb xml:id="p001_l_12"/>An[emarie</p>

            <milestone unit="textregion" xml:id="p001_r_1"/>            <p xmlns:local="local" local:warning="FML-generated-to-avoid-structural-problems"> 
               <lb xml:id="p001_l_13"/><hi rendition="#u">Suisse</hi> 
               <lb xml:id="p001_l_14"/>Mademaiselle Schlumberger 
               <lb xml:id="p001_l_15"/>Hotel Bernerhof 
               <lb xml:id="p001_l_16"/><hi rendition="#u">Gstaad</hi> 
               <lb xml:id="p001_l_17"/><del rend="overstrike">Paris VIIe[hochgestellt 
                  <lb xml:id="p001_l_18"/>7 Rue Las Cases</del> 
               <lb xml:id="p001_l_19"/>Oberland</p>
</div>

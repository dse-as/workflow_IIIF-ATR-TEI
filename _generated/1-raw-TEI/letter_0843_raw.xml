            <milestone unit="textregion" xml:id="letter_0843_001_r"/>
            <lb xml:id="letter_0843_001_l"/>Dominique chérie, je te souhaite
<lb xml:id="letter_0843_001_l_1"/>une bonne et heureuse
<lb xml:id="letter_0843_001_l_2"/>nuvelle année – et je 
<lb xml:id="letter_0843_001_l_3"/>t'attends avec impatience –
<lb xml:id="letter_0843_001_l_4"/>N'ayant pas ton adresse
<lb xml:id="letter_0843_001_l_5"/>je ne sais pas quand
<lb xml:id="letter_0843_001_l_6"/>tu auras cette carte –
<lb xml:id="letter_0843_001_l_7"/>Envoie-moi l'adresse de 
<lb xml:id="letter_0843_001_l_8"/>Anne!!! Alle guten Wünsche
<lb xml:id="letter_0843_001_l_9"/>von meiner ganzen Familie
<lb xml:id="letter_0843_001_l_10"/>u bitte Deine Eltern u. 
<lb xml:id="letter_0843_001_l_11"/>Sylvie –
<lb xml:id="letter_0843_001_l_12"/>An[emarie<milestone unit="textregion" xml:id="letter_0843_001_r_1"/>
            <lb xml:id="letter_0843_001_l_13"/><PAGE tag="underlined">Suisse</PAGE>
<lb xml:id="letter_0843_001_l_14"/>Mademaiselle Schlumberger
<lb xml:id="letter_0843_001_l_15"/>Hotel Bernerhof
<lb xml:id="letter_0843_001_l_16"/><PAGE tag="underlined">Gstaad</PAGE>
<lb xml:id="letter_0843_001_l_17"/><PAGE tag="strikethrough">Paris VIIe[hochgestellt</PAGE>
<lb xml:id="letter_0843_001_l_18"/><PAGE tag="strikethrough">7 Rue Las Cases</PAGE>
<lb xml:id="letter_0843_001_l_19"/>Oberland</div>

         <div type="letter">
            <pb xml:id="letter_0854_001"
                facs="https://iiif.ub.unibe.ch/image/v3/schwarzenbach/letter_0854_002.jpg"/>
            <milestone unit="textregion" xml:id="letter_0854_001_tr_1"/>
            <lb xml:id="letter_0854_001_tr_1_tl_1"/>Nov. 20, 37<CONV tag="p">
<lb xml:id="letter_0854_001_tr_1_tl_2"/>THIS SPACE FOR WRITING MESSAGES</CONV> <CONV tag="p">
<lb xml:id="letter_0854_001_tr_1_tl_3"/>Liebe Frau Storrer, es ist
<lb xml:id="letter_0854_001_tr_1_tl_5"/>leider einfach unmöglich
<lb xml:id="letter_0854_001_tr_1_tl_7"/>von unterwegs zu <PAGE tag="underlined">schreiben</PAGE>,
<lb xml:id="letter_0854_001_tr_1_tl_9"/>– ich meine: mehr als diesen
<lb xml:id="letter_0854_001_tr_1_tl_10"/>eiligen Brief. Die Landstrassen
<lb xml:id="letter_0854_001_tr_1_tl_11"/>sind zu lang, u. die Arbeit
<lb xml:id="letter_0854_001_tr_1_tl_12"/>zu schwierig, besonders für
<lb xml:id="letter_0854_001_tr_1_tl_14"/>den verdächtigen Ausländer
<lb xml:id="letter_0854_001_tr_1_tl_16"/>– u. hier im "South" ist man
<lb xml:id="letter_0854_001_tr_1_tl_17"/>dreifach verdächtig. Aber
<lb xml:id="letter_0854_001_tr_1_tl_19"/>es lohnt sich, weissgott, hier
<lb xml:id="letter_0854_001_tr_1_tl_20"/>etwas erfahren zu wollen –
<lb xml:id="letter_0854_001_tr_1_tl_22"/>das Land birst mit dra¬
<lb xml:id="letter_0854_001_tr_1_tl_23"/>matischem Fieber. Bald
<lb xml:id="letter_0854_001_tr_1_tl_24"/>mehr. Herzlich Ihre
<lb xml:id="letter_0854_001_tr_1_tl_25"/>An[n]emarie C.</CONV>
<lb xml:id="letter_0854_001_l"/>Frau F. Storrer
<lb xml:id="letter_0854_001_l_1"/>Rosengartenweg 6
<lb xml:id="letter_0854_001_l_2"/><PAGE tag="underlined">Basel</PAGE>
<lb xml:id="letter_0854_001_l_3"/><PAGE tag="underlined">Switzerland</PAGE>
<lb xml:id="letter_0854_001_tr_1_tl_4"/>POST-CARD
<lb xml:id="letter_0854_001_tr_1_tl_6"/>THIS SPACE FOR ADDRESS ONLY<milestone unit="textregion" xml:id="letter_0854_001_r"/>
            <lb xml:id="letter_0854_001_l_4"/>LUMBERTON N. C.
<lb xml:id="letter_0854_001_l_5"/>NOV 21
<lb xml:id="letter_0854_001_l_6"/>6 – PM
<lb xml:id="letter_0854_001_l_7"/>1937<pb xml:id="letter_0854_002"
                facs="https://iiif.ub.unibe.ch/image/v3/schwarzenbach/letter_0854_001.jpg"/>
            <milestone unit="textregion" xml:id="letter_0854_002_r"/><CONV tag="f">

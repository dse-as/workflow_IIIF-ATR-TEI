   <text>
      <body>
         <div type="letter">
            <pb xml:id="letter_0696_001"
                facs="https://iiif.ub.unibe.ch/image/v3/schwarzenbach/letter_0696_001.jpg"/>
            <milestone unit="textregion" xml:id="letter_0696_001_tr_2"/>
            <lb xml:id="letter_0696_001_tr_2_tl_2"/>Bocken bei Horgen
<lb xml:id="letter_0696_001_tr_2_tl_3"/>A.S.
<lb xml:id="letter_0696_001_tr_2_tl_4"/>Lieber Herr Haushofer –
<lb xml:id="letter_0696_001_tr_2_tl_5"/>es tut mir leid dass ich
<lb xml:id="letter_0696_001_tr_2_tl_6"/>Sie nicht mehr sprechen
<lb xml:id="letter_0696_001_tr_2_tl_7"/>konnte, die kleine Engadiner-
<lb xml:id="letter_0696_001_tr_2_tl_8"/>fahrt kann etwas plötzlich,
<lb xml:id="letter_0696_001_tr_2_tl_9"/>ich hätte mir, wen[ ich es
<lb xml:id="letter_0696_001_tr_2_tl_10"/>gewusst hätte, in Rüschlikon
<lb xml:id="letter_0696_001_tr_2_tl_11"/>noch Zeit genommen mit Ihnen
<lb xml:id="letter_0696_001_tr_2_tl_12"/>zu sprechen.
<lb xml:id="letter_0696_001_tr_2_tl_13"/>Ihre kleinen Gedichte lege ich
<lb xml:id="letter_0696_001_tr_2_tl_14"/>Ihnen wieder bei. Sie enthalten
<lb xml:id="letter_0696_001_tr_2_tl_15"/>eine Anfrage u. einen Wunsch
<lb xml:id="letter_0696_001_tr_2_tl_16"/>nach Bindung: ich weiss nicht<pb xml:id="letter_0696_002"
                facs="https://iiif.ub.unibe.ch/image/v3/schwarzenbach/letter_0696_002.jpg"/>
            <pb xml:id="letter_0696_003"
                facs="https://iiif.ub.unibe.ch/image/v3/schwarzenbach/letter_0696_003.jpg"/>
            <milestone unit="textregion" xml:id="letter_0696_003_tr_1"/>
            <lb xml:id="letter_0696_003_tr_1_tl_1"/>ob Sie sich in mich hinein¬
<lb xml:id="letter_0696_003_tr_1_tl_2"/>versetzen können, u. damit
<lb xml:id="letter_0696_003_tr_1_tl_3"/>einsehen, dass es für mich
<lb xml:id="letter_0696_003_tr_1_tl_4"/>unmöglich ist einen solchen
<lb xml:id="letter_0696_003_tr_1_tl_5"/>Vorschlag anzunehmen? Vielleicht
<lb xml:id="letter_0696_003_tr_1_tl_7"/>bin ich einfach zu jung, zu
<lb xml:id="letter_0696_003_tr_1_tl_8"/>erfüllt von selbständigen Plänen –
<lb xml:id="letter_0696_003_tr_1_tl_9"/>Es tut mir leid,
<lb xml:id="letter_0696_003_tr_1_tl_10"/>Ihnen weh zu tun, oder Sie
<lb xml:id="letter_0696_003_tr_1_tl_11"/>enttäuschen: ich weiss nicht ob
<lb xml:id="letter_0696_003_tr_1_tl_12"/>wir trotzdem weiterhin gute
<lb xml:id="letter_0696_003_tr_1_tl_13"/>Freunde bleiben werden, ob Sie mir
<lb xml:id="letter_0696_003_tr_1_tl_14"/>auch weiterhin mit Rat beistehen 
<lb xml:id="letter_0696_003_tr_1_tl_15"/>werden? Ich hoffe u. wünsche es
<lb xml:id="letter_0696_003_tr_1_tl_16"/>sehr.
<lb xml:id="letter_0696_003_tr_1_tl_17"/>Mit vielen Grüssen Ihr
<lb xml:id="letter_0696_003_tr_1_tl_18"/>An[emarie Schwarzenbach<pb xml:id="letter_0696_004"
                facs="https://iiif.ub.unibe.ch/image/v3/schwarzenbach/letter_0696_004.jpg"/>
            <milestone unit="textregion" xml:id="letter_0696_004_tr_2"/>
            <lb xml:id="letter_0696_004_tr_2_tl_1"/>Herrn Dr. A. von Haushofer
<lb xml:id="letter_0696_004_tr_2_tl_2"/>Berlin W 48
<lb xml:id="letter_0696_004_tr_2_tl_3"/>Wilhelmstrasse 23<pb xml:id="letter_0696_005"
                facs="https://iiif.ub.unibe.ch/image/v3/schwarzenbach/letter_0696_005.jpg"/>
